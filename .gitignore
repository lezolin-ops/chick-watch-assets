# Keep local build/dependency files out, while including new simulator sources.
/lvgl-simulator/*
!/lvgl-simulator/src/
!/lvgl-simulator/tools/
!/lvgl-simulator/DAILY_ANIMATION.md
/lvgl-simulator/tools/__pycache__/

# Downloaded/build-time tooling. Cloud setup recreates these.
/tools/

# Firmware: keep only sources; build/component/backup artifacts are reproducible.
/firmware/build/
/build-clock-preview/
/build-power/
/build-power-baseline/
/build/
/firmware/build-official/
/firmware/managed_components/
/firmware/backup/
/firmware/release/
/firmware/candidates/**/*.bin
/firmware/sdkconfig
/firmware/sdkconfig.old

# Local experiment runtimes and video outputs (not source).
/experiments/ltx_local/
/experiments/happy_motion_compare/

# Operating-system metadata.
.DS_Store

# Local archives and Python cache
/lvgl-simulator.zip
/firmware/sdkconfig.pre_psram_fix.bak
__pycache__/
*.pyc
